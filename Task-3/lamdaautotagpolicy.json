{
	"Version": "2012-10-17",
	"Statement": [
		{
			"Sid": "DescribeInstances",
			"Effect": "Allow",
			"Action": [
				"ec2:DescribeInstances"
			],
			"Resource": "*"
		},
		{
			"Sid": "TagInstances",
			"Effect": "Allow",
			"Action": [
				"ec2:CreateTags"
			],
			"Resource": "arn:aws:ec2:us-east-1:457660516966:instance/*"
		}
	]
}